# .env.example — token-saver proxy
# НИКОГДА не коммить .env с реальными значениями!
# Используй: doppler run -- docker compose -f docker-compose.proxy.yml up -d

# === LiteLLM ===
LITELLM_MASTER_KEY=sk-changeme-generate-with-openssl-rand
LITELLM_DATABASE_URL=postgresql://litellm:changeme@postgres:5432/litellm

# === Провайдеры (через Doppler config: dev/stg/prd) ===
GEMINI_API_KEY=           # Doppler: GEMINI_API_KEY
ANTHROPIC_API_KEY=        # Doppler: ANTHROPIC_API_KEY
NVIDIA_NIM_API_KEY=       # Doppler: NVIDIA_NIM_API_KEY
OPENROUTER_API_KEY=       # Doppler: OPENROUTER_API_KEY

# === Инфраструктура ===
POSTGRES_PASSWORD=changeme_via_doppler
DOPPLER_CONFIG=dev        # dev | stg | prd

# === Подключение агентов (экспортировать в шелле) ===
# export OPENAI_BASE_URL=http://localhost:4000/v1
# export ANTHROPIC_BASE_URL=http://localhost:4000/v1
# export OPENAI_API_KEY=sk-changeme-generate-with-openssl-rand
